# -----------------------------------------------------------------------------
# PadelHub Application Environment Configuration
# -----------------------------------------------------------------------------

APP_NAME=PadelHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL recommended, SQLite supported for testing)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=padel_book
DB_USERNAME=postgres
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Session & Cache Drivers
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Queue Configuration (database or redis for background jobs/notifications)
# Run worker: php artisan queue:work
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# Redis Configuration (Optional, for high-traffic caching & queues)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail Configuration (For sending booking confirmations and invoices)
# In local: log. In production: smtp, mailgun, resend, or ses.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="booking@padelhub.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# File Storage / AWS S3 (Optional, for avatar & court photos)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Midtrans Payment Gateway Configuration
# - For sandbox: set MIDTRANS_IS_PRODUCTION=false, use SB-Mid-server-* / SB-Mid-client-*
# - For production: set MIDTRANS_IS_PRODUCTION=true, use Mid-server-* / Mid-client-*
# -----------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# -----------------------------------------------------------------------------
# Frontend / Vite Configuration
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
